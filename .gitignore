# --- colcon / ROS 2 build output ---
# Regenerated by `colcon build`; never commit. Note these live in the container's
# writable layer anyway, so they vanish whenever the container is recreated.
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Deliberately NOT ignored ---
# erc_images/ is a Phase 1 deliverable: the solution node writes timestamped
# annotated images there during a trial and judges use them to award the
# identification points. Those must be committed, not ignored.
